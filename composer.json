{
  "name": "akki-team/sylius-slimpay-plugin",
  "description": "Slimpay payment gateway for Sylius, built on PaymentRequest",
  "type": "sylius-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Akki",
      "email": "support@akki.fr"
    }
  ],
  "require": {
    "php": "^8.2",
    "sylius/sylius": "^2.0",
    "akki-team/hapiclient": "^1.0"
  },
  "require-dev": {
    "php-http/guzzle7-adapter": "^1.0"
  },
  "repositories": {
    "akkiHapiclient": {
      "type": "vcs",
      "url": "https://github.com/akki-team/hapiclient-php.git"
    }
  },
  "autoload": {
    "psr-4": {
      "Akki\\SyliusSlimpayPlugin\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
